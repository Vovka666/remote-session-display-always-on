# Normalise to LF in the repository; Windows checkouts still get CRLF.
* text=auto

# PowerShell 5.1 reads scripts using the system code page unless there is a
# BOM, so every .ps1 here is plain ASCII with CRLF endings. CI enforces it.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.md  text eol=lf
*.yml text eol=lf

*.png binary
